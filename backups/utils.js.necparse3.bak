// utils.js — 纯函数层（自 v02 逐字迁移；告警文案/精度/分支不得改动）
// v0.5 i18n-3: getMmanaPos 告警改结构化条目 {key, params} — 屏显/写入两视图由调用方分别 L()/LF() 渲染
// 依赖: state.js (evalExpr 无状态, 此处不引用 N2M)

    function hasChinese(str) { return /[\u4e00-\u9fa5]/.test(str); }
    function removeChinese(str) { return str.replace(/[\u4e00-\u9fa5]/g, '').trim(); }
    // 行注释截断: ' ! ‘ ’ “ ” 及首个非 ASCII 字符 (变码注释 — EFHW 的 â 等; 2026-09-24 审计修复)
    function stripComment(line) {
        let s = line;
        const marks = ["'", '!', '\u2018', '\u2019', '\u201C', '\u201D'];
        let cut = -1;
        for (let mk of marks) { let i = s.indexOf(mk); if (i >= 0 && (cut < 0 || i < cut)) cut = i; }
        for (let i = 0; i < s.length; i++) { if (s.charCodeAt(i) > 0x7E) { if (cut < 0 || i < cut) cut = i; break; } }
        return cut >= 0 ? s.slice(0, cut) : s;
    }
    // 顶层分隔符切分 (括号配平: MOD(a,b) 内的逗号不切)
    function splitTopLevel(s, sep) {
        let out = [], depth = 0, cur = '';
        for (let i = 0; i < s.length; i++) {
            let ch = s[i];
            if (ch === '(') depth++;
            else if (ch === ')') depth = Math.max(0, depth - 1);
            if (ch === sep && depth === 0) { out.push(cur); cur = ''; }
            else cur += ch;
        }
        out.push(cur);
        return out;
    }
    // AWG 线规 → 导线半径(米): d(mm)=0.127×92^((36−n)/39), 半径=d/2/1000; n<0 对应 00/000/0000
    function awgRadius(n) { return 0.127 * Math.pow(92, (36 - n) / 39) / 2 / 1000; }
    // 括号配平: 从 openIdx ('(' 位置) 找匹配的 ')' 下标 (未配平返回 -1)
    function matchParen(s, openIdx) {
        let depth = 0;
        for (let k = openIdx; k < s.length; k++) {
            if (s[k] === '(') depth++;
            else if (s[k] === ')') { depth--; if (depth === 0) return k; }
        }
        return -1;
    }
    // NAME(...) 整体重写: prefix + 实参 + suffix (配平扫描; 用于 ATN/ASIN/ACOS 角度制)
    function rewriteCall(s, name, prefix, suffix) {
        let re = new RegExp('\\b' + name + '\\s*\\(', 'g');
        let m, out = '', last = 0;
        while ((m = re.exec(s)) !== null) {
            let open = s.indexOf('(', m.index);
            let close = matchParen(s, open);
            if (close < 0) break;
            out += s.slice(last, m.index) + prefix + s.slice(open + 1, close) + suffix;
            last = close + 1;
            re.lastIndex = last;
        }
        return out + s.slice(last);
    }
    // 幂改写: a^b → Math.pow(a,b) (括号感知; 左结合; 一元负号按 BASIC 语义: -x^2 = -(x^2))
    function rewritePow(s) {
        let guard = 0;
        while (s.indexOf('^') >= 0 && guard++ < 50) {
            let i = s.indexOf('^');
            let j = i - 1;
            while (j >= 0 && s[j] === ' ') j--;
            let endL = j;
            if (j >= 0 && s[j] === ')') {
                let depth = 0;
                for (; j >= 0; j--) { if (s[j] === ')') depth++; else if (s[j] === '(') { depth--; if (depth === 0) break; } }
                while (j > 0 && /[A-Za-z0-9_.]/.test(s[j - 1])) j--;   // 含函数/标识符前缀 (Math.pow 含小写)
            } else {
                while (j >= 0 && /[A-Za-z0-9_.]/.test(s[j])) j--;
                j++;
            }
            let base = s.slice(j, endL + 1);
            let k = i + 1;
            while (k < s.length && s[k] === ' ') k++;
            let startR = k;
            if (s[k] === '-' || s[k] === '+') k++;
            while (k < s.length && /[A-Za-z0-9_.]/.test(s[k])) k++;
            if (k < s.length && s[k] === '(') { let close = matchParen(s, k); k = close >= 0 ? close : k - 1; }
            else k--;
            let exp = s.slice(startR, k + 1);
            s = s.slice(0, j) + 'Math.pow(' + base + ',' + exp + ')' + s.slice(k + 1);
        }
        return s;
    }
    function evalExpr(exprStr, symbols) {
        // 2026-09-24 审计修复: 失败一律返回 NaN (不再静默 0); 调用方 isFinite 判定 → 跳过+告警 / GS 阻断
        if (exprStr === undefined || exprStr === null || exprStr === '') return NaN;
        let s = exprStr.toString().toUpperCase();

        // ① AWG 线规 #NN[/unit] → 半径数值(米; /unit → 以该单位计) — 必须在数值规范化前 (避免 #0000 被吃)
        if (s.indexOf('#') >= 0) {
            let awgBad = false;
            s = s.replace(/#\s*(\d{1,4})\s*(?:\/\s*(MM|CM|M|IN|FT))?/g, function (m0, digits, unit) {
                let n = /^0+$/.test(digits) ? -(digits.length - 1) : parseInt(digits, 10);   // #0→0, #00→-1, #000→-2, #0000→-3
                let r = awgRadius(n);
                if (!isFinite(r)) { awgBad = true; return 'NaN'; }
                if (unit) r = r / GS_UNITS[unit.toLowerCase()];
                return '(' + r + ')';
            });
            if (awgBad || s.indexOf('#') >= 0) return NaN;
        }

        // ② 前导零数值规范化 (按十进制: +00.27685 → +0.27685; 0021 → 21, 不再八进制)
        s = s.replace(/(^|[^\w.])0+(\d)/g, '$1$2');

        // ③ 电学单位后缀 (保留 v02 语义; 补 UF/NH)
        s = s.replace(/([0-9.]+)\s*UH/g, "$1E-6");
        s = s.replace(/([0-9.]+)\s*MH/g, "$1E-3");
        s = s.replace(/([0-9.]+)\s*PF/g, "$1E-12");
        s = s.replace(/([0-9.]+)\s*NF/g, "$1E-9");
        s = s.replace(/([0-9.]+)\s*UF/g, "$1E-6");
        s = s.replace(/([0-9.]+)\s*NH/g, "$1E-9");

        // ④ 长度单位字 (裸用/后缀/表达式+单位): MM/CM/IN/FT/M → 数值; 已定义符号同名时不替换
        s = replaceLengthUnits(s, symbols);

        // ⑤ 隐式乘法 (符号感知: 0.5D1 → 0.5*D1; 排除 Fortran E/D 指数形态 3.5E-3)
        for (let key in symbols) {
            const k = key.toUpperCase().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            s = s.replace(new RegExp('(^|[^A-Z0-9_])((?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+|\\)))\\s*(' + k + ')(?![A-Z0-9_])(?![+-]?\\d)', 'g'), '$1$2*$3');
        }

        let changed = true, iterations = 0;
        while (changed && iterations < 15) {
            changed = false;
            for (let key in symbols) {
                // S1-S2 修复: 键先做正则元字符转义 — 原实现在键含 ( ? * | $ [ 等时抛 "Unterminated group"
                //   未捕获异常直穿 UI, 或静默错配; 转义后按字面量匹配
                const safeKey = key.toUpperCase().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                let regex = new RegExp("\\b" + safeKey + "\\b", "g");
                if (regex.test(s)) {
                    s = s.replace(regex, "(" + symbols[key] + ")");
                    changed = true;
                }
            }
            iterations++;
            // 2026-09-24 审计修复: 长度护栏 — 自引用/循环定义可致文本膨胀 (修好一卡多声明后风险上升)
            if (s.length > 100000) return NaN;
        }

        // ⑥ 幂 (括号感知; 一元负号 BASIC 语义)
        s = rewritePow(s);

        // ⑦ 函数与常量 (统一 \b 边界: 修复 ASIN 被当 SIN、PITCH 被当 PI 等误替换)
        //   注意: PI 必须先替换 — 其后 ATN/SIN/COS/TAN 会插入 "Math.PI", 再替换会变成 Math.Math.PI
        s = s.replace(/\bPI\b/g, "Math.PI");
        s = rewriteCall(s, 'ATN', '(Math.atan(', ')*180/Math.PI)');     // 反正切 → 角度
        s = rewriteCall(s, 'ASIN', '(Math.asin(', ')*180/Math.PI)');
        s = rewriteCall(s, 'ACOS', '(Math.acos(', ')*180/Math.PI)');
        s = s.replace(/\bSQR\s*\(/g, "Math.sqrt(");
        s = s.replace(/\bSQRT\s*\(/g, "Math.sqrt(");
        s = s.replace(/\bSIN\s*\(/g, "Math.sin(Math.PI/180*");
        s = s.replace(/\bCOS\s*\(/g, "Math.cos(Math.PI/180*");
        s = s.replace(/\bTAN\s*\(/g, "Math.tan(Math.PI/180*");
        s = s.replace(/\bABS\s*\(/g, "Math.abs(");
        s = s.replace(/\bEXP\s*\(/g, "Math.exp(");
        s = s.replace(/\bLOG10\s*\(/g, "Math.log10(");
        s = s.replace(/\bLOG\s*\(/g, "Math.log(");
        s = s.replace(/\bINT\s*\(/g, "Math.floor(");
        s = s.replace(/\bFIX\s*\(/g, "Math.trunc(");
        s = s.replace(/\bSGN\s*\(/g, "Math.sign(");
        s = s.replace(/\bMOD\s*\(([^,()]+),([^()]+)\)/g, "(($1)%($2))");

        try {
            let v = new Function('return (' + s + ')')();
            return (typeof v === 'number' && isFinite(v)) ? v : NaN;
        } catch (e) { return NaN; }
    }
    // SY 卡声明解析 (2026-09-24 审计修复): 一卡多声明(顶层逗号) + 卡内顺序赋值(DE=…, DE=DE*8)
    //   立即求值写入符号表 (4NEC2 顺序语义); 失败 → 存 NaN + 告警条目 (由调用方聚合)
    function applySyDecl(cleanLine, symbols, notes) {
        let body = cleanLine.substring(2);
        for (let decl of splitTopLevel(body, ',')) {
            let eq = decl.indexOf('=');
            if (eq < 0) continue;
            let name = decl.slice(0, eq).trim().toUpperCase().replace(/\s+/g, '');
            if (!/^[A-Z_][A-Z0-9_]*$/.test(name)) continue;
            let expr = decl.slice(eq + 1).trim();
            let v = evalExpr(expr, symbols);
            if (isFinite(v)) { symbols[name] = v; }
            else {
                symbols[name] = NaN;
                if (notes) notes.push({ key: 'n2m.expr.evalFailed', params: { where: 'SY ' + name, expr: expr } });
            }
        }
    }
    const GS_UNITS = { mm: 0.001, cm: 0.01, m: 1, in: 0.0254, ft: 0.3048 };

    function parseGsScale(raw, symbols) {
        let s = raw.toString().trim().toUpperCase();
        // 1) 裸单位最先匹配 — 修复 "MM"/"CM" 被 [A-Z_][A-Z0-9_]* 拆成 M+M 的误判 (2026-09-24 审计修复)
        if (GS_UNITS.hasOwnProperty(s.toLowerCase())) return { val: GS_UNITS[s.toLowerCase()], unit: s };
        // 2) 值/表达式 + 单位后缀 ("135cm" / "2*ft" / ".3048ft"); 值部分不能是裸标识符(避免符号名尾字母被当单位)
        let m = s.match(/^(.*?)\s*(MM|CM|M|IN|FT)$/);
        if (m && m[1] !== '' && !/^[A-Z_][A-Z0-9_]*$/.test(m[1])) {
            let factor = GS_UNITS[m[2].toLowerCase()];
            let body = m[1];
            // 单位作后缀("135cm" → 135×0.01) 或作操作数("2*ft" → 2×(0.3048))
            let num = /[*/+\-(]\s*$/.test(body) ? evalExpr(body + '(' + factor + ')', symbols)
                                               : evalExpr(body + '*(' + factor + ')', symbols);
            if (isFinite(num) && num > 0) return { val: num, unit: m[2] };
        }
        // 3) 纯表达式/符号; 失败返回 NaN (调用方阻断, 不再静默按 1.0)
        let v = evalExpr(s, symbols);
        return { val: isFinite(v) && v > 0 ? v : NaN, unit: null };
    }
    // 长度单位字替换 (2026-09-24 审计修复): 裸用("FT"→0.3048) / 后缀("27.5ft") / 表达式+单位("42*ft")
    //   边界: 单位前后不得是标识符字符 (MIN/INP 不误伤); 同名已定义符号优先; 数字/标识符后插 '*'
    function replaceLengthUnits(s, symbols) {
        const UNIT_RE = /(MM|CM|IN|FT|M)/g;
        let out = '', last = 0, m;
        while ((m = UNIT_RE.exec(s)) !== null) {
            const u = m[1], start = m.index, end = start + u.length;
            const before = start > 0 ? s[start - 1] : '';
            const after = end < s.length ? s[end] : '';
            if (/[A-Z0-9_]/.test(after)) continue;                                  // INP / MMX
            if (/[A-Z_]/.test(before)) continue;                                    // MIN / SIN 内部
            // 整个 token (连续标识符字符) 若为已定义符号则跳过 (如 R01M)
            let ts = start; while (ts > 0 && /[A-Z0-9_]/.test(s[ts - 1])) ts--;
            let te = end; while (te < s.length && /[A-Z0-9_]/.test(s[te])) te++;
            if (symbols && Object.prototype.hasOwnProperty.call(symbols, s.slice(ts, te))) continue;
            let k = start - 1;
            while (k >= 0 && /\s/.test(s[k])) k--;
            const prev = k >= 0 ? s[k] : '';
            const sep = (/[0-9)]/.test(prev) || /[A-Z_]/.test(prev)) ? '*' : '';
            out += s.slice(last, start) + sep + '(' + GS_UNITS[u.toLowerCase()] + ')';
            last = end;
            UNIT_RE.lastIndex = end;
        }
        return out + s.slice(last);
    }
    // 卡字段切分 (2026-09-24 审计修复): 注释截断 + 空白/逗号切分 + 数值卡容错
    //   字段数正常(≤ 期望值) → 原样返回 (不合并, 避免误合并 "GS 0 0 mm");
    //   字段数异常(> 期望值) → 合并容错:
    //   a) 非 ASCII token 视为注释起始并截断 (弯引号/变码注释)
    //   b) token 恰为运算符 或 前一字段以运算符结尾 → 并入前一字段 (A + H / D/2 - g/2 / H+ L/2)
    //   c) token 是单位字且前一字段以数值/右括号结尾 → 并入 (-68 ft)
    function splitCardFields(cleanLine) {
        let s = stripComment(cleanLine);
        let toks = s.split(/[\s,]+/).filter(Boolean);
        if (!toks.length) return [];
        // 卡名与首字段粘连形态 ("GW1,8,-1.,..." / "GN1" / "EX5,1,4") → 拆开 (老 ARRL 文件)
        if (toks[0].length > 2 && /^[A-Z]{2}[0-9+\-.]/.test(toks[0])) {
            toks = [toks[0].slice(0, 2), toks[0].slice(2)].concat(toks.slice(1));
        }
        const expect = { GW: 10, GC: 7, GM: 10, GX: 3, GS: 4, GE: 2, EX: 6, LD: 7, FR: 6 }[toks[0]] || 0;
        if (expect && toks.length - 1 <= expect) return toks;
        let fields = [toks[0]];
        for (let i = 1; i < toks.length; i++) {
            let t = toks[i];
            if (/[^\x20-\x7E]/.test(t)) break;
            let prev = fields[fields.length - 1];
            if (t === '+' || t === '-' || t === '*' || t === '/' || t === '^') { fields[fields.length - 1] = prev + t; continue; }
            if (/[+\-*/^]\s*$/.test(prev)) { fields[fields.length - 1] = prev + t; continue; }
            if (GS_UNITS.hasOwnProperty(t.toLowerCase()) && /[0-9)]$/.test(prev)) { fields[fields.length - 1] = prev + t; continue; }
            fields.push(t);
        }
        return fields;
    }
    // 段定位 (2026-09-24 审计修复): tag=0 → segStr 为绝对段号(按段排列, 从 1 起);
    //   tag≠0 → (tag, 组内第 m 段), 同一 tag 可跨多根导线 (GR/ITGI=0 情形) 段组累计编号;
    //   百分比形态 → 返回该 tag 首根 + seg=null (由 getMmanaPos 按百分比处理); 未命中 → null
    function locateSegment(wires, tag, segStr, symbols) {
        let isPct = segStr.indexOf('%') >= 0;
        let m = Math.round(evalExpr(segStr.replace('%', ''), symbols));
        if (!isFinite(m)) return null;
        if (tag === 0) {
            if (isPct) return null;
            let acc = 0;
            for (let i = 0; i < wires.length; i++) {
                if (m <= acc + wires[i].ns) return { wireIdx: i, seg: m - acc };
                acc += wires[i].ns;
            }
            return null;
        }
        let acc = 0, first = -1;
        for (let i = 0; i < wires.length; i++) {
            if (wires[i].tag !== tag) continue;
            if (first < 0) first = i;
            if (!isPct && m <= acc + wires[i].ns) return { wireIdx: i, seg: m - acc };
            acc += wires[i].ns;
        }
        return first >= 0 ? { wireIdx: first, seg: isPct ? null : m } : null;
    }
    function formatNum(num) { return Number(num).toFixed(4); }
    // MMANA 手册(gal-ana.de/basicmm): W#C/B/E + 带符号偏移。
    // 935 真实文件实测: b/c 双向偏移常见; E 仅见 e1(向外跨线连接点), 未见 e-2 向内。
    // 故 E 锚只用于"末段本身"(offset=0); 线内后段一律用 c 偏移表达(c0+dc 恒在界内)。
    function segToDesignator(segIdx, ns) {
        if (ns <= 1) return { anchor: 'c', offset: 0 };
        let c0 = Math.floor((ns + 1) / 2);
        let db = segIdx - 1, dc = segIdx - c0, de = segIdx - ns;
        let absDb = Math.abs(db), absDc = Math.abs(dc), absDe = Math.abs(de);
        if (segIdx === ns) return { anchor: 'e', offset: 0 };
        if (absDc <= absDb) return { anchor: 'c', offset: dc };
        return { anchor: 'b', offset: db };
    }
    function getMmanaPos(tag, segStr, ns, symbols, warningsArray) {
        let isPercent = segStr.includes('%');
        let segValStr = segStr.replace('%', '');
        let segVal = evalExpr(segValStr, symbols);
        if (!isFinite(segVal)) segVal = 0;

        let segIdx;
        if (isPercent || (segVal > 0 && segVal < 1)) {
            let pct = isPercent ? segVal : segVal * 100;
            segIdx = Math.max(1, Math.min(ns, Math.round(pct / 100 * ns)));
            warningsArray.push({ key: 'n2m.tag.pct', params: { tag, pct, seg: segIdx, ns } });
        } 
        else {
            segIdx = Math.round(segVal);
            if (segIdx > ns) {
                warningsArray.push({ key: 'n2m.tag.overSeg', params: { tag, seg: segIdx, ns } });
                segIdx = ns;
            }
            if (segIdx < 1) {
                warningsArray.push({ key: 'n2m.tag.underSeg', params: { tag, seg: segIdx, ns } });
                segIdx = 1;
            }
        }

        let d = segToDesignator(segIdx, ns);
        let desig;
        if (d.anchor === 'c' && ns > 1 && d.offset === 0) desig = 'c';
        else if (d.offset === 0) desig = d.anchor;
        else if (Math.abs(d.offset) <= 1) desig = `${d.anchor}${d.offset}`;
        else {
            // |偏移|>1: MMANA 自动分段下大偏移会位漂移(设计符按 NEC 段数标定),
            // 与 935 文件生态一致(偏移仅用于连接点/中心旁1脉冲) → 收敛最近纯锚 + 告警
            let anchorSeg = d.anchor === 'c' ? Math.floor((ns + 1) / 2) : (d.anchor === 'b' ? 1 : ns);
            desig = d.anchor;
            warningsArray.push({ key: 'n2m.tag.bigOffset', params: { tag, seg: segIdx, ns, anchor: d.anchor, off: d.offset, anchorSeg } });
        }
        return desig;
    }
