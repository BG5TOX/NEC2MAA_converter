// geometry.js — 几何收集层（自 v02 逐字迁移；2026-09-24 NEC 解析审计修复批次）
// v0.5 i18n-3: GM 告警改结构化条目 {key, params} — 屏显/写入两视图由调用方分别 L()/LF() 渲染
// collectWires: GW/GX/GM/GR/GS/CW 按文件顺序单遍处理；GX 的 I2 为三位标志(百/十/个=X/Y/Z, Z→Y→X 反射);
//   GW 半径空白/0 = GC 锥度续行 → 跳过+告警；GM 旋转矩阵照抄 OpenNEC(R=Rz·Ry·Rx)；
//   NRPT=I2 控制复制(0=就地, n=追加 n 个副本)——副本逐轮累积变换(C_j=T^j(原作), NEC-2 move()),
//   每轮对 tag 只加一次 ITG(累加) ⇒ 副本 tag=原作+j·ITG；ITS=F7 只作用于"第一个 tag==ITS 的
//   线段到结构末尾"(按线段位置, 0/空=全结构)；平移处于"当前文件单位", 不乘缩放。
//   2026-09-24 审计修复:
//   - GS: NEC-2 顺序语义 — 就地缩放"此前已读入"的几何(含半径); I1/I2≠0 (XNEC2C 段范围) 不应用+告警;
//         解析失败 → n2m.gs.bad (调用方阻断转换)
//   - SY: 按文件顺序就地求值 (applySyDecl)
//   - GR: 绕 z 轴旋转复制 NR 份(含原作, 360/NR, tag+ITGI·j)
//   - NS=0: 不生成线段 (NEC 语义) + 告警; CW: 不支持告警(不再静默); NX: 只取首个数据集
//   - 字段切分走 splitCardFields (含空格表达式/数值+单位/非 ASCII 注释截断)
//   - 求值失败(NaN): 跳过该导线/该卡, 明细聚合为 n2m.expr.evalFailed
// 依赖: utils.js (evalExpr/parseGsScale/applySyDecl/stripComment/splitCardFields)。本文件不得引用 N2M/DOM。
    // 几何收集 (按文件顺序单遍处理，提取与转换共用，保证 tag 一致)
    function collectWires(lines, symbols, notes) {
        let wires = [];
        let gcTaperTags = [];
        let cwCount = 0;
        let exprFails = [];
        const note = (key, params) => { if (notes) notes.push({ key: key, params: params }); };
        const num = (expr, label) => {
            let v = evalExpr(expr, symbols);
            if (!isFinite(v) && label) exprFails.push(label + '="' + expr + '"');
            return v;
        };
        for (let line of lines) {
            let cleanLine = line.trim().toUpperCase();
            if (!cleanLine) continue;
            let parts = splitCardFields(cleanLine);
            if (!parts.length) continue;
            let card = parts[0];

            if (card === 'NX') {
                // 2026-09-24: 多数据集文件 — 只取第一个数据集 (不再合并)
                note('n2m.nx.multiDataset');
                break;
            } else if (card === 'SY') {
                // 2026-09-24 审计修复: SY 按文件顺序就地求值 (交错重定义/位置相关值; LoopCirc20 类文件)
                applySyDecl(stripComment(cleanLine), symbols, notes);
            } else if (card === 'GS') {
                // GS (NEC-2 顺序语义): 就地缩放此前几何(含半径); I1/I2≠0 段范围形态不应用; 失败 → 告警(调用方阻断)
                if (parts.length < 4) {
                    note('n2m.gs.bad', { raw: cleanLine });
                } else {
                    let i1 = parseInt(evalExpr(parts[1], symbols)) || 0;
                    let i2 = parseInt(evalExpr(parts[2], symbols)) || 0;
                    let gsRaw = parts[3];
                    // 容错: "0.3048 ft" 被空白拆成两字段 → 合并 (裸单位 "MM"/"FT" 不合并)
                    if (parts.length >= 5 && !GS_UNITS.hasOwnProperty(parts[3].toLowerCase()) && GS_UNITS.hasOwnProperty(parts[4].toLowerCase())) gsRaw = parts[3] + parts[4];
                    let gs = parseGsScale(gsRaw, symbols);
                    if (!isFinite(gs.val) || gs.val <= 0) {
                        note('n2m.gs.bad', { raw: gsRaw });
                    } else if (i1 !== 0 || i2 !== 0) {
                        // XNEC2C 生成的段范围缩放形态 (GS 3 4 0.775): 语义不明, 不应用 + 告警
                        note('n2m.gs.segRange', { i1: i1, i2: i2 });
                    } else {
                        for (let w of wires) {
                            w.x1 *= gs.val; w.y1 *= gs.val; w.z1 *= gs.val;
                            w.x2 *= gs.val; w.y2 *= gs.val; w.z2 *= gs.val;
                            w.rad *= gs.val;
                        }
                        if (gs.unit) note('n2m.gs.unit', { unit: gs.unit, val: gs.val });
                    }
                }
            } else if (card === 'GW' && parts.length >= 9) {
                if (parts.length - 1 > 10) note('n2m.card.fieldShape', { card: 'GW', n: parts.length - 1, expect: 10 });
                let fTag = num(parts[1], 'GW tag'), fNs = num(parts[2], 'GW NS');
                let x1 = num(parts[3], 'GW X1'), y1 = num(parts[4], 'GW Y1'), z1 = num(parts[5], 'GW Z1');
                let x2 = num(parts[6], 'GW X2'), y2 = num(parts[7], 'GW Y2'), z2 = num(parts[8], 'GW Z2');
                let hasRad = parts.length > 9;
                let fRad = hasRad ? evalExpr(parts[9], symbols) : 0;
                if (hasRad && !isFinite(fRad)) {
                    // 半径解析失败 ≠ GC 锥度: 独立告警 (审计 4.4: 原实现误导为"锥度已跳过")
                    note('n2m.gw.radUnparsed', { tag: parts[1], expr: parts[9] });
                } else if (!isFinite(fTag) || !isFinite(fNs) || [x1, y1, z1, x2, y2, z2].some(v => !isFinite(v))) {
                    // 坐标/段数求值失败 → 跳过该导线 (明细已由 num() 汇总为 n2m.expr.evalFailed)
                } else if (parseInt(fNs) === 0) {
                    // NEC: NS=0 不生成任何线段 (常用来"关掉"可选导线)
                    note('n2m.gw.ns0', { tag: parseInt(fTag) });
                } else if (!(fRad > 0)) {
                    // RAD 空白或 0 → 后续 GC 锥度续行卡; MMANA 无锥度振子等价物 → 跳过+聚合告警
                    gcTaperTags.push(parseInt(fTag) || 0);
                } else {
                    wires.push({
                        tag: parseInt(fTag),
                        ns: parseInt(fNs),
                        x1: x1, y1: y1, z1: z1,
                        x2: x2, y2: y2, z2: z2,
                        rad: fRad
                    });
                }
            } else if (card === 'GX' && parts.length >= 2) {
                let fItg = parts.length > 1 ? evalExpr(parts[1], symbols) : 0;
                let i2raw = parts.length > 2 ? String(parts[2]) : '0';
                let fI2 = /^[0-9]+$/.test(i2raw) ? parseInt(i2raw) : evalExpr(i2raw, symbols);
                if (!isFinite(fItg) || !isFinite(fI2)) {
                    exprFails.push('GX "' + parts.slice(1).join(' ') + '"');
                } else {
                let itg = parseInt(fItg) || 0;
                // I2 为三位数字标志: 百位=绕 X 镜像(反射 YZ 面), 十位=绕 Y, 个位=绕 Z
                //   实际文件写法如 "GX 20 010"(Y) / "GX 1 011"(Y+Z) / "GX 0 111"(X+Y+Z); NEC2 gx.html
                // 注意: evalExpr 经 new Function 求值, 前导 0 字面量按八进制("010"→8);
                //   I2 是数字标志串, 必须按原始文本从右取位, 不能经 evalExpr
                let i2str = /^[0-9]+$/.test(i2raw) ? i2raw : String(Math.abs(parseInt(fI2) || 0));
                let d = i2str.replace(/[^0-9]/g, '');
                let izz = d.length >= 1 ? +d[d.length - 1] : 0;
                let iyy = d.length >= 2 ? +d[d.length - 2] : 0;
                let ixx = d.length >= 3 ? +d[d.length - 3] : 0;

                let current_wires = [...wires];
                let inc_mult = 1;

                // 多面对称按字母逆序 Z→Y→X 依次反射, 每层 tag 增量翻倍 (I1, 2·I1, 4·I1);
                //   tag=0 为无效 tag, 不递增 (与 GM 分支一致; NEC2 gx.html "valid tags")
                if (izz > 0) {
                    let new_wires = current_wires.map(w => ({
                        ...w, tag: w.tag !== 0 ? w.tag + itg * inc_mult : 0, z1: -w.z1, z2: -w.z2
                    }));
                    wires.push(...new_wires);
                    current_wires = [...wires];
                    inc_mult *= 2;
                }
                if (iyy > 0) {
                    let new_wires = current_wires.map(w => ({
                        ...w, tag: w.tag !== 0 ? w.tag + itg * inc_mult : 0, y1: -w.y1, y2: -w.y2
                    }));
                    wires.push(...new_wires);
                    current_wires = [...wires];
                    inc_mult *= 2;
                }
                if (ixx > 0) {
                    let new_wires = current_wires.map(w => ({
                        ...w, tag: w.tag !== 0 ? w.tag + itg * inc_mult : 0, x1: -w.x1, x2: -w.x2
                    }));
                    wires.push(...new_wires);
                }
                }
            } else if (card === 'GM' && parts.length >= 2) {
                let fItg = parts.length > 1 ? evalExpr(parts[1], symbols) : 0;
                let fNrpt = parts.length > 2 ? evalExpr(parts[2], symbols) : 0;
                let frx = parts.length > 3 ? evalExpr(parts[3], symbols) : 0;
                let fry = parts.length > 4 ? evalExpr(parts[4], symbols) : 0;
                let frz = parts.length > 5 ? evalExpr(parts[5], symbols) : 0;
                let ftx = parts.length > 6 ? evalExpr(parts[6], symbols) : 0;
                let fty = parts.length > 7 ? evalExpr(parts[7], symbols) : 0;
                let ftz = parts.length > 8 ? evalExpr(parts[8], symbols) : 0;
                let fIts = parts.length > 9 ? evalExpr(parts[9], symbols) : 0;
                if (![fItg, fNrpt, frx, fry, frz, ftx, fty, ftz, fIts].every(isFinite)) {
                    // 2026-09-24: GM 字段求值失败 → 跳过该卡 (否则 NaN 变换污染全结构)
                    exprFails.push('GM "' + parts.slice(1).join(' ') + '"');
                } else {
                let itg = parseInt(fItg) || 0;
                let nrpt = parseInt(fNrpt) || 0;
                let rx = frx, ry = fry, rz = frz;
                let tx = ftx, ty = fty, tz = ftz;
                // ITS (F7, 第 10 字段): 小数输入, NEC 四舍五入为整数; 只变换"第一个 tag==ITS 的
                //   线段到结构末尾"(按线段位置, 非 tag 数值比较); 0/空 = 全结构 (NEC2 gm.html)
                let its = Math.round(fIts || 0);

                if ((rx !== 0 && ry !== 0) || (ry !== 0 && rz !== 0) || (rx !== 0 && rz !== 0)) {
                    note('n2m.gm.multiAxis', { rx: rx, ry: ry, rz: rz });
                }

                let start = 0;
                if (its > 0) {
                    let idx = wires.findIndex(w => w.tag === its);
                    if (idx < 0) {
                        // NEC 原生遇此报 "NO SEGMENT HAS AN ITAG" 终止; 导入器从宽: 告警 + 按全结构
                        note('n2m.gm.itsNotFound', { its: its });
                    } else {
                        start = idx;
                    }
                }

                let d2r = Math.PI / 180;
                let sps = Math.sin(rx * d2r), cps = Math.cos(rx * d2r);
                let sth = Math.sin(ry * d2r), cth = Math.cos(ry * d2r);
                let sph = Math.sin(rz * d2r), cph = Math.cos(rz * d2r);
                let xx = cph * cth, xy = cph * sth * sps - sph * cps, xz = cph * sth * cps + sph * sps;
                let yx = sph * cth, yy = sph * sth * sps + cph * cps, yz = sph * sth * cps - cph * sps;
                let zx = -sth, zy = cth * sps, zz = cth * cps;

                let transform = w => ({
                    ...w,
                    x1: w.x1 * xx + w.y1 * xy + w.z1 * xz + tx,
                    y1: w.x1 * yx + w.y1 * yy + w.z1 * yz + ty,
                    z1: w.x1 * zx + w.y1 * zy + w.z1 * zz + tz,
                    x2: w.x2 * xx + w.y2 * xy + w.z2 * xz + tx,
                    y2: w.x2 * yx + w.y2 * yy + w.z2 * yz + ty,
                    z2: w.x2 * zx + w.y2 * zy + w.z2 * zz + tz
                });

                if (nrpt > 0) {
                    // S1-M1 修复: 导线总量预算 — 原实现 nrpt×wires 无上限 (GM 0,1e8 → 5e8 对象 3s OOM 实证)
                    //   超预算时停止扩展并告警, 保留已生成的合法部分
                    const budget = 200000;
                    // 预算按 ITS 起实际复制量: 现有 n 根 + nrpt × (n − start)
                    const copySize = wires.length - start;
                    const projected = wires.length + nrpt * copySize;
                    if (projected > budget) {
                        note('n2m.gm.budget', { nrpt: nrpt, n: wires.length, budget: budget });
                    } else {
                        // NEC-2 move(): 每轮把"上一轮副本"整体再变换一次 (副本 = T^j(原作));
                        //   且每轮只对 tag 加一次 ITG (累加) ⇒ 副本 tag = 原作 + j·ITG
                        let srcStart = start;
                        for (let j = 0; j < nrpt; j++) {
                            const srcEnd = wires.length;
                            for (let i = srcStart; i < srcEnd; i++) {
                                let c = transform(wires[i]);
                                if (wires[i].tag !== 0) c.tag = wires[i].tag + itg;
                                wires.push(c);
                            }
                            srcStart = srcEnd;
                        }
                    }
                } else {
                    for (let i = start; i < wires.length; i++) {
                        wires[i] = transform(wires[i]);
                        if (wires[i].tag !== 0) wires[i].tag += itg;
                    }
                }
                }
            } else if (card === 'GR' && parts.length >= 3) {
                // GR ITGI NR: 把当前结构绕 z 轴旋转复制成 NR 份(含原作), 相邻两份夹角 360/NR,
                //   tag 每份递增 ITGI (NEC-2 gr.html; ITGI=0 常见 → 各份 tag 相同)
                let itg = parseInt(evalExpr(parts[1], symbols)) || 0;
                let nr = parseInt(evalExpr(parts[2], symbols)) || 0;
                if (nr > 1 && wires.length > 0) {
                    const budget = 200000;
                    if (wires.length * nr > budget) {
                        note('n2m.gm.budget', { nrpt: nr - 1, n: wires.length, budget: budget });
                    } else {
                        const snap = [...wires];
                        const d2r = Math.PI / 180;
                        for (let j = 1; j < nr; j++) {
                            const ang = j * 360 / nr * d2r;
                            const ca = Math.cos(ang), sa = Math.sin(ang);
                            for (const w of snap) {
                                let c = {
                                    ...w,
                                    x1: w.x1 * ca - w.y1 * sa, y1: w.x1 * sa + w.y1 * ca,
                                    x2: w.x2 * ca - w.y2 * sa, y2: w.x2 * sa + w.y2 * ca
                                };
                                if (w.tag !== 0) c.tag = w.tag + itg * j;
                                wires.push(c);
                            }
                        }
                    }
                }
            } else if (card === 'CW') {
                // NEC-4 悬链线: MMANA 无等价物 → 计数 + 聚合告警 (原实现静默丢线)
                cwCount++;
            }
        }
        // 聚合告警 (避免大文件逐根刷屏)
        if (gcTaperTags.length > 0) note('n2m.gw.gcTaper', { tag: gcTaperTags[0], count: gcTaperTags.length });
        if (cwCount > 0) note('n2m.cw.unsupported', { count: cwCount });
        if (exprFails.length > 0) {
            let uniq = [...new Set(exprFails)];
            note('n2m.expr.evalFailed', { where: 'geometry', expr: uniq.slice(0, 5).join(' | ') + (uniq.length > 5 ? ' …' : '') });
        }
        return wires;
    }
