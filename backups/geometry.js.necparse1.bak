// geometry.js — 几何收集层（自 v02 逐字迁移）
// v0.5 i18n-3: GM 告警改结构化条目 {key, params} — 屏显/写入两视图由调用方分别 L()/LF() 渲染
// collectWires: GW/GX/GM 按文件顺序单遍处理；GX 的 I2 为三位标志(百/十/个=X/Y/Z, Z→Y→X 反射);
//   GW 半径空白/0 = GC 锥度续行 → 跳过+告警；GM 旋转矩阵照抄 OpenNEC(R=Rz·Ry·Rx)；
//   NRPT=I2 控制复制(0=就地, n=追加 n 个副本)——副本逐轮累积变换(C_j=T^j(原作), NEC-2 move()),
//   每轮对 tag 只加一次 ITG(累加) ⇒ 副本 tag=原作+j·ITG；ITS=F7 只作用于"第一个 tag==ITS 的
//   线段到结构末尾"(按线段位置, 0/空=全结构)；平移与坐标同处文件单位, 随 GS 缩放。
// 依赖: utils.js (evalExpr)。本文件不得引用 N2M/DOM。
    // 几何收集 (GW/GX/GM 按文件顺序单遍处理，提取与转换共用，保证 tag 一致)
    function collectWires(lines, symbols, globalScale, gmNotes) {
        let wires = [];
        let gcTaperTags = [];
        for (let line of lines) {
            let cleanLine = line.trim().toUpperCase();
            let parts = cleanLine.split(/[\s,]+/).filter(Boolean);
            if (parts[0] === 'GW' && parts.length >= 9) {
                // RAD 空白或 0 → 后续 GC 锥度续行卡 (NEC2 gw.html); MMANA 无锥度振子等价物 → 跳过+告警
                let radRaw = parts.length > 9 ? evalExpr(parts[9], symbols) : 0;
                if (!(radRaw > 0)) {
                    gcTaperTags.push(parseInt(evalExpr(parts[1], symbols)) || 0);
                } else {
                    wires.push({
                        tag: parseInt(evalExpr(parts[1], symbols)),
                        ns: parseInt(evalExpr(parts[2], symbols)),
                        x1: evalExpr(parts[3], symbols) * globalScale, 
                        y1: evalExpr(parts[4], symbols) * globalScale, 
                        z1: evalExpr(parts[5], symbols) * globalScale,
                        x2: evalExpr(parts[6], symbols) * globalScale, 
                        y2: evalExpr(parts[7], symbols) * globalScale, 
                        z2: evalExpr(parts[8], symbols) * globalScale,
                        rad: radRaw * globalScale
                    });
                }
            } else if (parts[0] === 'GX' && parts.length >= 2) {
                let itg = parts.length > 1 ? (parseInt(evalExpr(parts[1], symbols)) || 0) : 0;
                // I2 为三位数字标志: 百位=绕 X 镜像(反射 YZ 面), 十位=绕 Y, 个位=绕 Z
                //   实际文件写法如 "GX 20 010"(Y) / "GX 1 011"(Y+Z) / "GX 0 111"(X+Y+Z); NEC2 gx.html
                // 注意: evalExpr 经 new Function 求值, 前导 0 字面量按八进制("010"→8);
                //   I2 是数字标志串, 必须按原始文本从右取位, 不能经 evalExpr
                let i2raw = parts.length > 2 ? String(parts[2]) : '0';
                let i2str = /^[0-9]+$/.test(i2raw) ? i2raw : String(Math.abs(parseInt(evalExpr(i2raw, symbols)) || 0));
                let d = i2str.replace(/[^0-9]/g, '');
                let izz = d.length >= 1 ? +d[d.length - 1] : 0;
                let iyy = d.length >= 2 ? +d[d.length - 2] : 0;
                let ixx = d.length >= 3 ? +d[d.length - 3] : 0;

                let current_wires = [...wires];
                let inc_mult = 1;

                // 多面对称按字母逆序 Z→Y→X 依次反射, 每层 tag 增量翻倍 (I1, 2·I1, 4·I1);
                //   tag=0 为无效 tag, 不递增 (与 GM 分支一致; NEC2 gx.html "valid tags")
                if (izz > 0) {
                    let new_wires = current_wires.map(w => ({
                        ...w, tag: w.tag !== 0 ? w.tag + itg * inc_mult : 0, z1: -w.z1, z2: -w.z2
                    }));
                    wires.push(...new_wires);
                    current_wires = [...wires];
                    inc_mult *= 2;
                }
                if (iyy > 0) {
                    let new_wires = current_wires.map(w => ({
                        ...w, tag: w.tag !== 0 ? w.tag + itg * inc_mult : 0, y1: -w.y1, y2: -w.y2
                    }));
                    wires.push(...new_wires);
                    current_wires = [...wires];
                    inc_mult *= 2;
                }
                if (ixx > 0) {
                    let new_wires = current_wires.map(w => ({
                        ...w, tag: w.tag !== 0 ? w.tag + itg * inc_mult : 0, x1: -w.x1, x2: -w.x2
                    }));
                    wires.push(...new_wires);
                }
            } else if (parts[0] === 'GM' && parts.length >= 2) {
                let itg = parts.length > 1 ? (parseInt(evalExpr(parts[1], symbols)) || 0) : 0;
                let nrpt = parts.length > 2 ? (parseInt(evalExpr(parts[2], symbols)) || 0) : 0;
                let rx = parts.length > 3 ? evalExpr(parts[3], symbols) : 0;
                let ry = parts.length > 4 ? evalExpr(parts[4], symbols) : 0;
                let rz = parts.length > 5 ? evalExpr(parts[5], symbols) : 0;
                let tx = (parts.length > 6 ? evalExpr(parts[6], symbols) : 0) * globalScale;
                let ty = (parts.length > 7 ? evalExpr(parts[7], symbols) : 0) * globalScale;
                let tz = (parts.length > 8 ? evalExpr(parts[8], symbols) : 0) * globalScale;
                // ITS (F7, 第 10 字段): 小数输入, NEC 四舍五入为整数; 只变换"第一个 tag==ITS 的
                //   线段到结构末尾"(按线段位置, 非 tag 数值比较); 0/空 = 全结构 (NEC2 gm.html)
                let its = parts.length > 9 ? Math.round(evalExpr(parts[9], symbols) || 0) : 0;
                
                if ((rx !== 0 && ry !== 0) || (ry !== 0 && rz !== 0) || (rx !== 0 && rz !== 0)) {
                    if (gmNotes) gmNotes.push({ key: 'n2m.gm.multiAxis', params: { rx, ry, rz } });
                }

                let start = 0;
                if (its > 0) {
                    let idx = wires.findIndex(w => w.tag === its);
                    if (idx < 0) {
                        // NEC 原生遇此报 "NO SEGMENT HAS AN ITAG" 终止; 导入器从宽: 告警 + 按全结构
                        if (gmNotes) gmNotes.push({ key: 'n2m.gm.itsNotFound', params: { its } });
                    } else {
                        start = idx;
                    }
                }
                
                let d2r = Math.PI / 180;
                let sps = Math.sin(rx * d2r), cps = Math.cos(rx * d2r);
                let sth = Math.sin(ry * d2r), cth = Math.cos(ry * d2r);
                let sph = Math.sin(rz * d2r), cph = Math.cos(rz * d2r);
                let xx = cph * cth, xy = cph * sth * sps - sph * cps, xz = cph * sth * cps + sph * sps;
                let yx = sph * cth, yy = sph * sth * sps + cph * cps, yz = sph * sth * cps - cph * sps;
                let zx = -sth, zy = cth * sps, zz = cth * cps;
                
                let transform = w => ({
                    ...w,
                    x1: w.x1 * xx + w.y1 * xy + w.z1 * xz + tx,
                    y1: w.x1 * yx + w.y1 * yy + w.z1 * yz + ty,
                    z1: w.x1 * zx + w.y1 * zy + w.z1 * zz + tz,
                    x2: w.x2 * xx + w.y2 * xy + w.z2 * xz + tx,
                    y2: w.x2 * yx + w.y2 * yy + w.z2 * yz + ty,
                    z2: w.x2 * zx + w.y2 * zy + w.z2 * zz + tz
                });
                
                if (nrpt > 0) {
                    // S1-M1 修复: 导线总量预算 — 原实现 nrpt×wires 无上限 (GM 0,1e8 → 5e8 对象 3s OOM 实证)
                    //   超预算时停止扩展并告警, 保留已生成的合法部分
                    const budget = 200000;
                    // 预算按 ITS 起实际复制量: 现有 n 根 + nrpt × (n − start)
                    const copySize = wires.length - start;
                    const projected = wires.length + nrpt * copySize;
                    if (projected > budget) {
                        if (gmNotes) gmNotes.push({ key: 'n2m.gm.budget', params: { nrpt, n: wires.length, budget } });
                    } else {
                        // NEC-2 move(): 每轮把"上一轮副本"整体再变换一次 (副本 = T^j(原作));
                        //   且每轮只对 tag 加一次 ITG (累加) ⇒ 副本 tag = 原作 + j·ITG
                        let srcStart = start;
                        for (let j = 0; j < nrpt; j++) {
                            const srcEnd = wires.length;
                            for (let i = srcStart; i < srcEnd; i++) {
                                let c = transform(wires[i]);
                                if (wires[i].tag !== 0) c.tag = wires[i].tag + itg;
                                wires.push(c);
                            }
                            srcStart = srcEnd;
                        }
                    }
                } else {
                    for (let i = start; i < wires.length; i++) {
                        wires[i] = transform(wires[i]);
                        if (wires[i].tag !== 0) wires[i].tag += itg;
                    }
                }
            }
        }
        // GC 锥度导线聚合为单条告警 (避免大文件逐根刷屏)
        if (gcTaperTags.length > 0 && gmNotes) {
            gmNotes.push({ key: 'n2m.gw.gcTaper', params: { tag: gcTaperTags[0], count: gcTaperTags.length } });
        }
        return wires;
    }
