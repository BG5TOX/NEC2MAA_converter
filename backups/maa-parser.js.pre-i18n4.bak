// maa-parser.js — .maa 解析层（R1, MA A→NEC 方向）
// 职责: 双变体检测 + 分节收集 + 设计符解析 + 注释 ASCII 检测/聚合
// 变体: A(无 ***Wires*** 节头, 三计数行 nw nl ns) / B(有节头, 单计数行) — 上下文判别
// λ 模式: 半径=99999.9 哨兵 + SEG=0.01 → 坐标为波长倍数, 按 299.7925/f 换算回米
// 依赖: 无 (纯函数层; 告警经外部数组返回)
// 注: 本文件不得引用 N2M/DOM。

    const MAA_LAMBDA_SENTINEL = 99999.9;

    function isAsciiText(s) { return /^[\x20-\x7E]*$/.test(s); }

    // w? 行形态判别: 源=3字段(phase,mag); 负载=4字段(1,R,X)/5字段(0,L,C,Q)/12字段(S参数)
    function isSourceShape(t) {
        const p = t.split(',').map(s => s.trim());
        if (p.length === 3) return true;
        if (p.length === 4 && (p[1] === '0' || p[1] === '1')) return false;
        if (p.length === 5 && p[1] === '0') return false;
        if (p.length === 12) return false;
        return false;
    }

    // 设计符解析: "w3c+1" / "W10C-1" / "v1e" → { wire, anchor, offset } 或 null
    function parseMaaDesignator(d) {
        let m = String(d).trim().match(/^[WwVv](\d+)([cCbBeE])([+-]?\d+)?$/);
        if (!m) return null;
        return { wire: parseInt(m[1], 10), anchor: m[2].toLowerCase(), offset: m[3] ? parseInt(m[3], 10) : 0 };
    }

    // 主解析: 返回 { title, titleAscii, freq, wires[], sources[], loads[], segParams, ground, comments[],
    //              warnings[], droppedNonAscii, variant, lambdaMode, taperDefs }
    // taperDefs (R21): { byName: Map<负半径, {type, pairs:[{L,R,isTail}], lineNo}>, declaredCount, parsedCount }
    function parseMaa(text, fileName) {
        let warnings = [];
        let droppedNonAscii = { title: false, commentLines: 0, totalCommentLines: 0 };
        const lines = text.split(/\r?\n/);

        // ---- 预扫描: 变体判别 ----
        // B 变体特征: "***Wires***" 节头; A 变体: 无该节头, 计数行紧随频率
        // 兼容: 俄文版 MMANA 单星节头 "* Провода *" (以 * 开头以 * 结尾, 内含文字)
        let variant = 'A';
        for (let l of lines) {
            let t = l.trim();
            if (/^\*\*\*\s*(wires|провода)/i.test(t)) { variant = 'B'; break; }
            if (t.startsWith('***')) break;
            if (/^\*[^*]+\*$/.test(t)) continue;              // 单星节头 (俄文等)
            if (/^-?\d[\d\s.,eE+-]*$/.test(t) && t.includes(',')) break;  // 数据行先于任何节头 → A
        }

        // ---- 结构化读取 ----
        let result = { title: '', titleAscii: true, freq: '', wires: [], sources: [], loads: [],
                       segParams: null, ground: null, comments: [], warnings,
                       droppedNonAscii, variant, lambdaMode: false,
                       taperDefs: { byName: new Map(), declaredCount: 0, parsedCount: 0 } };

        // 1. 标题: 首个非 * 非 *** 非数字行 (变体 B 标题可选)
        let idx = 0;
        let title = '';
        let sawStar = false;
        for (; idx < Math.min(6, lines.length); idx++) {
            let t = lines[idx].trim();
            if (t === '' ) continue;
            if (t === '*') { sawStar = true; continue; }
            if (t.startsWith('***') || t.startsWith('###')) break;
            if (/^-?\d+\.?\d*(e[+-]?\d+)?$/i.test(t)) { break; }  // 频率先行(无标题)
            title = t; idx++; break;
        }
        result.title = title;
        result.titleAscii = isAsciiText(title);
        if (title && !result.titleAscii) droppedNonAscii.title = true;

        // 2. 频率: 标题后(或 * 后)首个纯数字行
        for (; idx < Math.min(10, lines.length); idx++) {
            let t = lines[idx].trim();
            if (/^-?\d+\.?\d*(e[+-]?\d+)?$/i.test(t)) { result.freq = t; idx++; break; }
        }

        // 3. 计数行: B 变体在 ***Wires***(含俄文)节头后单值; A 变体在频率后 (首值为导线数, 可带多值)
        let wireCount = 0;
        if (variant === 'B') {
            for (; idx < lines.length; idx++) {
                if (/^\*\*\*\s*(wires|провода)/i.test(lines[idx].trim())) {
                    for (let j = idx + 1; j < lines.length; j++) {
                        let t = lines[j].trim();
                        if (/^\d+/.test(t)) { wireCount = parseInt(t.split(/[,\s]+/)[0], 10); idx = j + 1; break; }
                        if (t === '' || /^\*[^*]+\*$/.test(t)) continue;
                        break;
                    }
                    break;
                }
            }
        } else {
            for (; idx < Math.min(idx + 5, lines.length); idx++) {
                let t = lines[idx].trim();
                if (/^\*[^*]+\*$/.test(t)) continue;            // 单星节头跳过
                let m = t.match(/^(\d+)([,\s].*)?$/);
                if (m) { wireCount = parseInt(m[1], 10); idx++; break; }
            }
        }
        if (wireCount <= 0) warnings.push('[错误] 未找到有效的导线计数行, 解析中止。');
        result.wireCount = wireCount;

        // 4. 导线行 (紧跟计数, 到下一节头/非数据行为止)
        let w = 0;
        for (; idx < lines.length && w < wireCount; idx++) {
            let t = lines[idx].trim();
            if (t.startsWith('***') || t.startsWith('###') || t.startsWith('!')) break;
            let p = t.split(',').map(s => s.trim());
            if (p.length < 8) break;
            let wire = { x1: parseFloat(p[0]), y1: parseFloat(p[1]), z1: parseFloat(p[2]),
                        x2: parseFloat(p[3]), y2: parseFloat(p[4]), z2: parseFloat(p[5]),
                        rad: parseFloat(p[6]), segRaw: p[7], lineNo: idx + 1 };
            if (!isFinite(wire.x1) || !isFinite(wire.rad)) break;
            result.wires.push(wire); w++;
        }

        // λ 模式疑点已定案(2026-09-01 R1): 99999.9/0.01 出现在 "$$$ Taper wire set $$$" 锥形渐变定义区(20 文件),
        // 不属于导线坐标或 λ 存盘模式 — 该区已被 $$$ 跳过逻辑忽略, 导线区无此形态, 检测移除。

        // 5. 节区扫描: Source / Load / Segmentation / G-H / Comment / Taper(R21)
        let section = '';
        let pendingCount = 0;
        let taperRemaining = null;   // R21: $$$ 区剩余待读定义数 (null=尚未读数量行)
        for (; idx < lines.length; idx++) {
            let t = lines[idx].trim();
            if (t === '') continue;
            // 节头识别: 支持 *** 与单星 *xxx* 两种形态 (ZZ1_hen 等用 *G/H/M/R/AzEl/X* 单星)
            if (t.startsWith('***') || /^\*[^*]+\*$/.test(t)) {
                // SF1-S4: 离开 $$$ 区时尚有声明数未满足 → 告警 (EOF 场景由循环后兜底检查覆盖)
                if (section === 'taper' && taperRemaining !== null && taperRemaining > 0) {
                    warnings.push(`[警告] $$$ 锥度区声明 ${result.taperDefs.declaredCount} 个组合, 实际仅解析到 ${result.taperDefs.parsedCount} 个 (遇节头中断)。`);
                }
                // 节头匹配: 英文关键词优先; 俄文变码(编码不可靠)时退化为"顺序位置"推进 + 数据形态分类兜底。
                // 数据形态分类(核心): w? 行看第2列与字段数 — 源: phase,mag(3字段); 负载: 0/1+LCQ/RX(5/4字段)。
                let low = t.replace(/\*/g, '').trim().toLowerCase();
                if (low.includes('source') || low.includes('источ')) { section = 'src'; pendingCount = 1; }
                else if (low.includes('load') || low.includes('нагруз')) { section = 'load'; pendingCount = 1; }
                else if (low.includes('segment') || low.includes('автосегм') || low.includes('сегмент')) { section = 'seg'; pendingCount = 0; }
                else if (low.includes('g/h') || low.startsWith('g/h') || low.includes('gh/m')) { section = 'gh'; pendingCount = 0; }
                else { section = 'auto'; pendingCount = 1; }   // 变码/未知节头: 吃计数行, 数据形态自分类
                continue;
            }
            if (t.startsWith('###')) {
                // SF1-S4: 离开 $$$ 区时尚有声明数未满足 → 告警 (EOF 场景由循环后兜底覆盖)
                if (section === 'taper' && taperRemaining !== null && taperRemaining > 0) {
                    warnings.push(`[警告] $$$ 锥度区声明 ${result.taperDefs.declaredCount} 个组合, 实际仅解析到 ${result.taperDefs.parsedCount} 个 (遇注释节中断)。`);
                }
                section = 'cm';
                // 同行注释 or 下行
                let sameLine = t.replace(/^###Comment###\s*/, '').replace(/^###.*?###\s*/, '');
                if (sameLine) { collectComment(result, sameLine); }
                continue;
            }
            if (t.startsWith('$$$')) {
                // R21: $$$ 锥度组合定义区 (英文 "Taper wire set" / 俄文变码标签) — 捕获而非跳过
                // 标签文字不匹配 (CP1251 变码不可靠), 只认 $$$ 前缀; 位置不依赖 (库内均在 G/H 后, 实现不假设)
                section = 'taper';
                taperRemaining = null;   // 下一非空行 = 组合数量
                continue;
            }

            if (pendingCount > 0) { pendingCount--; continue; }

            if (section === 'taper') {
                // 5a. 锥度定义区: 数量行 → 逐行定义 (名称<0, type, L/R 对…)
                if (taperRemaining === null) {
                    taperRemaining = parseInt(t.split(/[,\s]+/)[0], 10);
                    if (!isFinite(taperRemaining) || taperRemaining < 0) taperRemaining = 0;
                    result.taperDefs.declaredCount = taperRemaining;
                    if (taperRemaining === 0) section = '';
                    continue;
                }
                const p = t.split(',').map(s => s.trim());
                const name = parseFloat(p[0]);
                const type = parseInt(p[1], 10);
                if (!isFinite(name) || name >= 0 || !isFinite(type)) {
                    warnings.push(`[警告] $$$ 锥度定义行格式非法(须为 负半径, 类型, L/R 对…), 已跳过: ${t.slice(0, 60)}`);
                } else {
                    if (result.taperDefs.byName.has(name)) {
                        warnings.push(`[警告] $$$ 锥度组合名 ${name} 重复定义, 已保留首个, 忽略后续 (行 ${idx + 1})。`);
                    } else {
                        const pairs = [];
                        for (let k = 2; k + 1 < p.length; k += 2) {
                            const L = parseFloat(p[k]), R = parseFloat(p[k + 1]);
                            if (!isFinite(L) || !isFinite(R)) {
                                warnings.push(`[警告] $$$ 锥度组合 ${name} 第 ${((k - 2) / 2) + 1} 对 L/R 数值非法, 该对已忽略。`);
                                continue;
                            }
                            pairs.push({ L, R, isTail: L >= 99999 });
                        }
                        if (pairs.length === 0) {
                            warnings.push(`[警告] $$$ 锥度组合 ${name} 无有效 L/R 对, 已忽略该定义。`);
                        } else {
                            result.taperDefs.byName.set(name, { type, pairs, lineNo: idx + 1 });
                            result.taperDefs.parsedCount++;
                        }
                    }
                }
                taperRemaining--;
                if (taperRemaining <= 0) section = '';
                continue;
            }

            if (section === 'src' || (section === 'auto' && /^[WwVv]\d/.test(t) && isSourceShape(t))) {
                // B: w?c, phase, mag  |  A: wire, seg, mag, phase
                if (/^[WwVv]\d/.test(t)) {
                    let p = t.split(',').map(s => s.trim());
                    let d = parseMaaDesignator(p[0]);
                    if (d) result.sources.push({ type: 'desig', desig: p[0], wire: d.wire, anchor: d.anchor, offset: d.offset,
                                                  phase: parseFloat(p[1]) || 0, mag: parseFloat(p[2]) || 0, lineNo: idx + 1 });
                } else if (/^\d+[\s,]/.test(t)) {
                    let p = t.split(/[,\s]+/).filter(Boolean);
                    if (p.length >= 4) result.sources.push({ type: 'numA', wire: parseInt(p[0]), seg: parseFloat(p[1]),
                                                             mag: parseFloat(p[2]), phase: parseFloat(p[3]), lineNo: idx + 1 });
                }
            } else if (section === 'load' || (section === 'auto' && /^[WwVv]\d/.test(t) && !isSourceShape(t))) {
                if (/^[WwVv]\d/.test(t)) {
                    let p = t.split(',').map(s => s.trim());
                    let d = parseMaaDesignator(p[0]);
                    let typeCol = p[1] !== undefined ? p[1].trim() : '';
                    if (d) {
                        if (typeCol === '0') result.loads.push({ type: 'lc', desig: p[0], wire: d.wire, anchor: d.anchor, offset: d.offset,
                                                                L_uH: parseFloat(p[2]) || 0, C_pF: parseFloat(p[3]) || 0, Q: parseFloat(p[4]) || 0, lineNo: idx + 1 });
                        else if (typeCol === '1') result.loads.push({ type: 'rjx', desig: p[0], wire: d.wire, anchor: d.anchor, offset: d.offset,
                                                                      R: parseFloat(p[2]) || 0, X: parseFloat(p[3]) || 0, lineNo: idx + 1 });
                        else if (p.length === 12) result.loads.push({ type: 'sparam', desig: p[0], raw: t, lineNo: idx + 1 });
                        else result.loads.push({ type: 'unknown', desig: p[0], raw: t, lineNo: idx + 1 });
                    }
                } else if (/^\d+[\s,]/.test(t)) {
                    // Variant A 六字段: wire, seg, R, X, L, C
                    let p = t.split(/[,\s]+/).filter(Boolean);
                    if (p.length >= 6) result.loads.push({ type: 'A6', wire: parseInt(p[0]), seg: parseFloat(p[1]),
                                                           R: parseFloat(p[2]) || 0, X: parseFloat(p[3]) || 0,
                                                           L: parseFloat(p[4]) || 0, C: parseFloat(p[5]) || 0, lineNo: idx + 1 });
                }
            } else if (section === 'seg') {
                let p = t.split(',').map(s => s.trim());
                if (p.length >= 4 && result.segParams === null) {
                    result.segParams = { dm1: parseInt(p[0]) || 0, dm2: parseInt(p[1]) || 0, sc: parseFloat(p[2]) || 0, ec: parseInt(p[3]) || 0 };
                }
                section = '';
            } else if (section === 'gh') {
                // G/H/M/R/AzEl/X 行 (2026-09-02 用户定名语义为准):
                //   1=G 地面类型, 2=H 附加高度, 3=M 材料序号, 4=R 阻抗实部,
                //   5=Az 6=El 后瓣F/B统计范围, 7=X 阻抗虚部
                let p = t.split(',').map(s => s.trim());
                if (p.length >= 7 && result.ground === null) {
                    result.ground = { gtype: parseInt(p[0]) || 0, height: parseFloat(p[1]) || 0, material: parseInt(p[2]) || 0,
                                      refZ: parseFloat(p[3]) || 50, az: parseFloat(p[4]) || 0, el: parseFloat(p[5]) || 0, x: parseFloat(p[6]) || 0 };
                }
                section = '';
            } else if (section === 'cm') {
                collectComment(result, t);
            }
        }
        // SF1-S4: EOF 兜底 — $$$ 区在文件尾声明数未满足 (遇节头场景已在前置检查覆盖)
        if (section === 'taper' && taperRemaining !== null && taperRemaining > 0) {
            warnings.push(`[警告] $$$ 锥度区声明 ${result.taperDefs.declaredCount} 个组合, 实际仅解析到 ${result.taperDefs.parsedCount} 个 (文件结束)。`);
        }

        function collectComment(res, text) {
            res.comments.push(text);
            droppedNonAscii.totalCommentLines++;
            if (!isAsciiText(text)) droppedNonAscii.commentLines++;
        }

        // 聚合警告 (ASCII 策略)
        if (droppedNonAscii.title || droppedNonAscii.commentLines > 0) {
            let parts = [];
            if (droppedNonAscii.title) parts.push('标题');
            if (droppedNonAscii.commentLines > 0) parts.push(`${droppedNonAscii.commentLines}/${droppedNonAscii.totalCommentLines} 行注释`);
            warnings.push(`[警告] 源文件含非英文内容(${parts.join(' + ')}), 已按"纯 ASCII 输出"策略丢弃, 不写入 NEC 文件。原始内容仍保存在 .maa 源文件中, 如需保留请自行转译。`);
        }
        if (result.loads.some(l => l.type === 'sparam')) warnings.push('[警告] 检测到 S 参数负载(12 字段行), NEC 无对应结构, 已跳转并保留原行到警告记录。');
        if (result.wires.length !== wireCount && wireCount > 0) warnings.push(`[警告] 实际解析到 ${result.wires.length} 根导线, 与计数行声明(${wireCount})不符, 请人工核查。`);

        return result;
    }
